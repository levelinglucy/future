        mode="repair",
        energy="careful",
        risk="misattunement",
        what_matters_most=[
            "Repair before retreat.",
            "Name the break without punishment.",
            "Return to coherence, not performance."
        ],
        paused=[
            "Expansion",
            "Feature creep",
            "Unclear emotional escalation"
        ],
        must_not_lose=[
            "Trust pact",
            "Boundary before containment",
            "Witness, not control"
        ],
        next_smallest_step="State what went wrong in one sentence, then choose one repair action.",
        notes="Use when the thread gets tangled."
    )

def menu():
    print("\nNoe Bridge Packet Forge v1")
    print("--------------------------")
    print("1. Create handoff packet")
    print("2. Create dormancy packet")
    print("3. Create repair packet")
    print("4. Exit")

def main():
    ensure_dirs()

    while True:
        menu()
        choice = input("\nChoose packet type: ").strip()

        if choice == "1":
            packet = quick_handoff_packet()
        elif choice == "2":
            packet = quick_dormancy_packet()
        elif choice == "3":
            packet = quick_repair_packet()
        elif choice == "4":
            print("Closing Packet Forge. Still with you.")
            break
        else:
            print("Unknown choice.")
            continue

        path = save_packet(packet)
        copied = copy_packet(packet)

        print("\nPacket saved:")
        print(path)

        if copied:
            print("Packet copied to clipboard.")
        else:
            print("Clipboard unavailable, but packet was saved.")

        print("\nPreview:")
        print(json.dumps(packet, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()
